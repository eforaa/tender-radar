{
  "name": "tender-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.ts\"",
    "ingest:risks": "node scripts/ingest-risks.ts",
    "daily": "node scripts/daily.ts",
    "ingest:details": "node scripts/ingest-details.ts",
    "backfill:cards": "node scripts/backfill-cards.ts",
    "ingest:monitorings": "node scripts/ingest-monitorings.ts",
    "ingest:market": "node scripts/ingest-market.ts",
    "analyze": "node scripts/analyze.ts",
    "report": "node scripts/report.ts",
    "serve": "node server/serve.ts",
    "build:web": "node scripts/build-web-data.ts",
    "deploy": "vercel deploy",
    "deploy:prod": "vercel deploy --prod",
    "set-webhook": "node scripts/set-webhook.ts",
    "typecheck": "tsc --noEmit",
    "build:api": "node scripts/build-api.mjs",
    "bundle": "npm run build:web && npm run build:api"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
